# g1-acq — Google One SKU mapping for Anywhere (port of upstream v7.11)
# Rewrites 20TB / 30TB to their 3-month 75p promos and the 2TB annual SKUs to
# the 12-month 90p offer, each only when the region response lists that target.
# Logs every g1.* / com.google.one.* / com.google.gemini.* ID for mapping new
# tiers. No network calls, body edits only.
name = g1-acq
description = Port of crhywun/g1-acq v7.11.0: 2TB -> 12-month 90p, 20TB / 30TB -> 3-month 75p, only when the region lists the target

[MITM]
name = Google One AI
hostname = one.google.com
1, 100, ^https://one\.google\.com/ai\?, 
