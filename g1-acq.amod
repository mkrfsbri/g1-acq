# g1-acq — Google One SKU mapping for Anywhere (port of upstream v7.10)
name = g1-acq
description = Port of crhywun/g1-acq v7.10.0. Per-source target preference: 1-month trial (used even when the response does not enumerate it, which is how the Ultra trial is sold), then the 3-month 75p offer (only when listed), 2TB -> 12-month 90p when listed. Passive SKU collection logging. No network calls, body edits only.

[MITM]
name = Google One AI
hostname = one.google.com
1, 100, ^https://one\.google\.com/ai\?, 
