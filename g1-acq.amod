# g1-acq — Google One SKU mapping for Anywhere (port of upstream v7.10)
name = g1-acq
description = Port of crhywun/g1-acq v7.10.0. 20TB / 30TB -> 3-month 75p, 2TB -> 12-month 90p, each only when the region response lists that target, so the store never rejects checkout. Passive SKU collection logging. No network calls, body edits only.

[MITM]
name = Google One AI
hostname = one.google.com
1, 100, ^https://one\.google\.com/ai\?, 
