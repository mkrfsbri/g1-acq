#!name=G1 ACQ SKU 管理
#!desc=v7.10.0 本机报告新增土区旧30TB历史2949.99里拉、Ultra三个月75p、2TB/Pro12个月90p三套预制模板，点击应用模板直接合并保存，同match/from更新启用并保留ID与其他手动规则，超过30条整批失败；保存后下一次 /ai? 响应使用配置；保留手动增删改、启停与恢复默认，默认discount75仍为20TB/30TB三个月75p（75% off、实付25%、2.5折）与2TB目标g1.2tb.ai.12months_ip_90p（无 .acq），模板或手动保存为custom，fallback=false；运行版本g1-acq-v7.10-mappings；土区仅公开历史报价，金额周期按App Store显示；保留采集、最近10次响应、JSON导出与schema1，清空记录不清映射；关闭旧模块后只开启一个改写入口，重新连接再打开方案页
#!system=ios

[Rule]
# 拦截 UDP 443，促使支持回退的 HTTP/3 请求改走 TCP。
AND,((PROTOCOL,UDP),(DEST-PORT,443)),REJECT-NO-DROP

[Script]
g1-acq = type=http-response,pattern=^https:\/\/one\.google\.com\/,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/mkrfsbri/g1-acq@v7.11.0/g1-acq-discount.js
g1-sku-report = type=http-request,pattern=^https:\/\/one\.google\.com\/g1-sku-report\/?(?:\?.*)?$,requires-body=1,max-size=0,script-path=https://cdn.jsdelivr.net/gh/mkrfsbri/g1-acq@v7.11.0/g1-sku-report-discount.js

[MITM]
hostname = %APPEND% one.google.com
