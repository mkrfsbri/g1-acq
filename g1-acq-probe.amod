# g1-acq-probe — Google One SKU collector for Anywhere (no rewriting)
# Logs every g1.* / com.google.one.* / com.google.gemini.* ID plus the raw plan
# fields of each one.google.com/ai response, so you can enumerate the real
# catalog of any region or account. Pair it with g1-acq.amod to map targets.
name = g1-acq-probe
description = Collector only: logs every SKU in the Google One plan response. Never rewrites.

[MITM]
name = Google One AI
hostname = one.google.com
1, 100, ^https://one\.google\.com/ai\?, 
